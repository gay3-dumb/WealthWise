<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wealthwise.ui.PriceAlertsController"
            styleClass="alerts-dialog" headerText="Price Alerts"
            prefWidth="500" prefHeight="620">
    <content>
        <VBox spacing="10" styleClass="alerts-content">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>
            <Label text="Create alerts for assets in your portfolio. Prices are checked whenever the simulated price changes."
                   wrapText="true"/>
            <Label text="Asset"/>
            <ComboBox fx:id="assetCombo" maxWidth="Infinity" promptText="Select a holding"/>
            <Label fx:id="currentPriceLabel" styleClass="alert-current-price" text="Current price: —"/>
            <Label text="Target price"/>
            <TextField fx:id="targetField" promptText="e.g. 1000.00"/>
            <Label text="Condition"/>
            <ComboBox fx:id="conditionCombo" maxWidth="Infinity"/>
            <Button text="Create Alert" onAction="#onCreateAlert" styleClass="buy-button"
                    maxWidth="Infinity"/>
            <Label fx:id="messageLabel" wrapText="true" styleClass="message-label"/>
            <Separator/>
            <Label text="Alerts" styleClass="section-title"/>
            <Label text="Active alerts are monitored. Triggered alerts remain visible until removed."
                   wrapText="true" styleClass="hint-label"/>
            <ListView fx:id="alertList" styleClass="alert-list" VBox.vgrow="ALWAYS"
                      prefHeight="240"/>
            <Button fx:id="removeButton" text="Remove Selected Alert" onAction="#onRemoveAlert"
                    styleClass="sellall-button" maxWidth="Infinity"/>
        </VBox>
    </content>
</DialogPane>
