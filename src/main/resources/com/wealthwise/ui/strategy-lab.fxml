<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DialogPane?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ProgressIndicator?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>

<DialogPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wealthwise.ui.StrategyLabController"
            styleClass="alerts-dialog" headerText="Strategy Lab"
            prefWidth="820" prefHeight="700">
    <content>
        <VBox spacing="10" styleClass="alerts-content">
            <padding><Insets top="12" right="14" bottom="12" left="14"/></padding>

            <Label wrapText="true"
                   text="Test three investing strategies against thousands of possible futures for one asset. Every strategy faces the same random price paths, so the comparison is fair. The paths are shared across several worker threads."/>

            <GridPane hgap="12" vgap="8">
                <columnConstraints>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                    <ColumnConstraints minWidth="150"/>
                    <ColumnConstraints hgrow="ALWAYS"/>
                </columnConstraints>

                <Label text="Use a holding's price" GridPane.rowIndex="0" GridPane.columnIndex="0"/>
                <ComboBox fx:id="assetCombo" maxWidth="Infinity" promptText="Optional"
                          GridPane.rowIndex="0" GridPane.columnIndex="1" GridPane.columnSpan="3"/>

                <Label text="Start price" GridPane.rowIndex="1" GridPane.columnIndex="0"/>
                <TextField fx:id="startPriceField" GridPane.rowIndex="1" GridPane.columnIndex="1"/>
                <Label text="Starting cash" GridPane.rowIndex="1" GridPane.columnIndex="2"/>
                <TextField fx:id="cashField" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="Days to simulate" GridPane.rowIndex="2" GridPane.columnIndex="0"/>
                <TextField fx:id="daysField" GridPane.rowIndex="2" GridPane.columnIndex="1"/>
                <Label text="Number of simulations" GridPane.rowIndex="2" GridPane.columnIndex="2"/>
                <TextField fx:id="simulationsField" GridPane.rowIndex="2" GridPane.columnIndex="3"/>

                <Label text="Daily volatility (%)" GridPane.rowIndex="3" GridPane.columnIndex="0"/>
                <TextField fx:id="volatilityField" GridPane.rowIndex="3" GridPane.columnIndex="1"/>
                <Label text="Daily drift (%)" GridPane.rowIndex="3" GridPane.columnIndex="2"/>
                <TextField fx:id="driftField" GridPane.rowIndex="3" GridPane.columnIndex="3"/>

                <Label text="Monthly buying: every (days)" GridPane.rowIndex="4" GridPane.columnIndex="0"/>
                <TextField fx:id="buyIntervalField" GridPane.rowIndex="4" GridPane.columnIndex="1"/>
                <Label text="Monthly buying: purchases" GridPane.rowIndex="4" GridPane.columnIndex="2"/>
                <TextField fx:id="buyCountField" GridPane.rowIndex="4" GridPane.columnIndex="3"/>

                <Label text="Trailing stop (% fall)" GridPane.rowIndex="5" GridPane.columnIndex="0"/>
                <TextField fx:id="stopField" GridPane.rowIndex="5" GridPane.columnIndex="1"/>
            </GridPane>

            <HBox spacing="12" alignment="CENTER_LEFT">
                <Button fx:id="runButton" text="Run Simulation" onAction="#onRun"
                        styleClass="buy-button" prefWidth="200"/>
                <ProgressIndicator fx:id="progress" visible="false" prefWidth="24" prefHeight="24"/>
                <Label fx:id="messageLabel" wrapText="true" styleClass="message-label"/>
            </HBox>

            <Separator/>
            <Label text="Results" styleClass="section-title"/>
            <TableView fx:id="resultTable" prefHeight="150" VBox.vgrow="ALWAYS">
                <columnResizePolicy>
                    <TableView fx:constant="CONSTRAINED_RESIZE_POLICY"/>
                </columnResizePolicy>
                <columns>
                    <TableColumn fx:id="colStrategy" text="Strategy"/>
                    <TableColumn fx:id="colWorst" text="Worst case (5%)"/>
                    <TableColumn fx:id="colMedian" text="Median"/>
                    <TableColumn fx:id="colBest" text="Best case (95%)"/>
                    <TableColumn fx:id="colLoss" text="Chance of loss"/>
                    <TableColumn fx:id="colDrawdown" text="Avg biggest fall"/>
                    <TableColumn fx:id="colBeat" text="Beats buy and hold"/>
                </columns>
            </TableView>
            <Label fx:id="verdictLabel" wrapText="true" styleClass="section-title"/>
            <Label fx:id="summaryLabel" wrapText="true" styleClass="hint-label"/>
            <Label wrapText="true" styleClass="hint-label"
                   text="These are simulated futures built from random price moves. They are not predictions, real markets can behave differently, and no fees or taxes are included. Worst case means only 5% of simulations ended lower; best case means only 5% ended higher."/>
        </VBox>
    </content>
</DialogPane>
