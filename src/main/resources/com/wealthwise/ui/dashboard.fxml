<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.LineChart?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.chart.PieChart?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Spinner?>
<?import javafx.scene.control.TableColumn?>
<?import javafx.scene.control.TableView?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleButton?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<BorderPane xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="com.wealthwise.ui.DashboardController" styleClass="root-pane">

    <!-- ============ TOP: title + summary cards ============ -->
    <top>
        <VBox spacing="12">
            <padding><Insets top="16" right="20" bottom="8" left="20"/></padding>
            <HBox spacing="12" alignment="CENTER_LEFT">
                <Label text="WealthWise" styleClass="app-title"/>
                <Label text="Portfolio &amp; Wealth Dashboard" styleClass="app-subtitle"/>
                <HBox HBox.hgrow="ALWAYS"/>
                <Label fx:id="statusLabel" styleClass="status-label"/>
                <Button fx:id="alertsButton" text="Price Alerts"
                        onAction="#onManageAlerts" styleClass="toolbar-button"/>
                <Button text="Export CSV" onAction="#onExportPortfolio"
                        styleClass="toolbar-button"/>
                <ToggleButton fx:id="simToggle" text="Pause prices" onAction="#onToggleSimulation"/>
            </HBox>
            <HBox spacing="14">
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="TOTAL VALUE" styleClass="card-title"/>
                    <Label fx:id="totalValueLabel" styleClass="card-value" text="0.00"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="INVESTED" styleClass="card-title"/>
                    <Label fx:id="investedLabel" styleClass="card-value" text="0.00"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="PROFIT / LOSS" styleClass="card-title"/>
                    <Label fx:id="profitLossLabel" styleClass="card-value" text="0.00"/>
                </VBox>
                <VBox styleClass="card" HBox.hgrow="ALWAYS">
                    <Label text="RETURN" styleClass="card-title"/>
                    <Label fx:id="returnLabel" styleClass="card-value" text="0.00%"/>
                </VBox>
            </HBox>
            <HBox fx:id="notificationBar" spacing="10" alignment="CENTER_LEFT"
                  styleClass="alert-notification" visible="false" managed="false">
                <Label fx:id="notificationLabel" styleClass="alert-notification-text"
                       wrapText="true" HBox.hgrow="ALWAYS"/>
                <Button text="Dismiss" onAction="#onDismissNotifications"
                        styleClass="notification-dismiss-button"/>
            </HBox>
        </VBox>
    </top>

    <!-- ============ CENTER: trade | concentration | holdings | history, charts below ============ -->
    <center>
        <HBox spacing="12" styleClass="workspace">
            <padding><Insets top="8" right="16" bottom="16" left="16"/></padding>

            <!-- 1. Record a Trade: same width and contents, now full height -->
            <ScrollPane fx:id="sideScroll" fitToWidth="true" hbarPolicy="NEVER"
                        vbarPolicy="AS_NEEDED" prefWidth="260" minWidth="240" maxWidth="270"
                        styleClass="side-scroll">
                <VBox fx:id="sidePanel" spacing="10" styleClass="side-panel" prefWidth="260">
                    <padding><Insets top="14" right="16" bottom="14" left="16"/></padding>
                    <Label text="Record a Trade" styleClass="section-title"/>
                    <Label text="Symbol (e.g. AAPL)"/>
                    <TextField fx:id="symbolField" promptText="AAPL"/>
                    <Label text="Asset name (new assets)"/>
                    <TextField fx:id="nameField" promptText="Apple Inc."/>
                    <Label text="Quantity"/>
                    <TextField fx:id="quantityField" promptText="10"/>
                    <Label text="Price per unit"/>
                    <TextField fx:id="priceField" promptText="150.00"/>
                    <HBox spacing="10">
                        <Button text="Buy" onAction="#onBuy" styleClass="buy-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                        <Button text="Sell" onAction="#onSell" styleClass="sell-button" maxWidth="Infinity" HBox.hgrow="ALWAYS"/>
                    </HBox>
                    <Button text="Sell All Holdings" onAction="#onSellAll" styleClass="sellall-button" maxWidth="Infinity"/>
                    <Label fx:id="messageLabel" wrapText="true" styleClass="message-label"/>

                    <!-- Portfolio Concentration sits directly below Record a Trade -->
                    <VBox spacing="8" styleClass="concentration-section">
                        <Text text="Portfolio Concentration" styleClass="section-title-text"
                              wrappingWidth="185"/>
                        <Label text="Warn above"/>
                        <HBox spacing="6" alignment="CENTER_LEFT">
                            <Spinner fx:id="thresholdSpinner" prefWidth="72" editable="true"/>
                            <Label text="\%"/>
                        </HBox>
                        <Text fx:id="concentrationStatusLabel" styleClass="concentration-status"
                              wrappingWidth="185" text="No holdings to analyze yet."/>
                        <ListView fx:id="warningList" styleClass="warning-list" prefHeight="120"
                                  minHeight="40" visible="false" managed="false"/>
                    </VBox>
                </VBox>
            </ScrollPane>

            <VBox spacing="12" HBox.hgrow="ALWAYS">
                <!-- Holdings takes the center; transaction history keeps its own scrolling on the right -->
                <HBox spacing="12" VBox.vgrow="ALWAYS" prefHeight="250" minHeight="180">
                    <VBox spacing="10" styleClass="workspace-panel" HBox.hgrow="ALWAYS" minWidth="360">
                        <Label text="Holdings" styleClass="section-title"/>
                        <TableView fx:id="holdingsTable" VBox.vgrow="ALWAYS" minHeight="120">
                            <columns>
                                <TableColumn fx:id="colSymbol" text="Symbol" prefWidth="62"/>
                                <TableColumn fx:id="colName" text="Name" prefWidth="110"/>
                                <TableColumn fx:id="colQty" text="Qty" prefWidth="55"/>
                                <TableColumn fx:id="colAvg" text="Avg Buy" prefWidth="78"/>
                                <TableColumn fx:id="colPrice" text="Price" prefWidth="78"/>
                                <TableColumn fx:id="colValue" text="Value" prefWidth="88"/>
                                <TableColumn fx:id="colAlloc" text="Allocation %" prefWidth="88"/>
                                <TableColumn fx:id="colPL" text="P/L" prefWidth="78"/>
                                <TableColumn fx:id="colRet" text="Return" prefWidth="68"/>
                            </columns>
                        </TableView>
                    </VBox>

                    <VBox spacing="10" styleClass="workspace-panel"
                          prefWidth="280" minWidth="230" maxWidth="340">
                        <Label text="Transaction history" styleClass="section-title"/>
                        <ListView fx:id="historyList" styleClass="history-list" VBox.vgrow="ALWAYS"/>
                    </VBox>
                </HBox>

                <!-- Charts keep their place under Holdings and Transaction history -->
                <HBox spacing="12" VBox.vgrow="ALWAYS" prefHeight="250" minHeight="170">
                    <LineChart fx:id="valueChart" title="Portfolio value (live)" createSymbols="false"
                               legendVisible="false" animated="false" HBox.hgrow="ALWAYS">
                        <xAxis><CategoryAxis fx:id="timeAxis" label="Time"/></xAxis>
                        <yAxis><NumberAxis fx:id="valueAxis" forceZeroInRange="false" label="Value"/></yAxis>
                    </LineChart>
                    <PieChart fx:id="allocationChart" title="Allocation" legendVisible="true"
                              animated="false" prefWidth="300" minWidth="220" maxWidth="340"/>
                </HBox>
            </VBox>
        </HBox>
    </center>
</BorderPane>
